# Runtime files — don't version
antenna.log
antenna.log.*
test-results/
antenna-config.json
antenna-peers.json
antenna-lists.json
antenna-public-groups.json
antenna-inbox.json
state/
__pycache__/
*.py[cod]

# Secrets — never commit
**/secrets/
*.token

# OpenClaw workspace artifacts (auto-generated in agent/)
agent/.openclaw/
agent/BOOTSTRAP.md
agent/HEARTBEAT.md
agent/IDENTITY.md
agent/SOUL.md
agent/USER.md
agent/models.json

# OS junk
.DS_Store
Thumbs.db
*.txt:Zone.Identifier
antenna-ratelimit.json
antenna-*.lock
*.pre-ticket-*
*.age.txt
agent/auth-profiles.json

# Runtime backups created by antenna-cli during destructive ops
antenna-config.json.bak.*
antenna-peers.json.bak.*
antenna-inbox.json.bak.*

# Retired secrets (moved out of secrets/ during cleanup, never shipped)
secrets.retired/
agent/memory

# OpenClaw may initialize a checkout itself as an agent workspace. These
# installation-local root files are not part of the Antenna source tree.
/AGENTS.md
/HEARTBEAT.md
/IDENTITY.md
/SOUL.md
/TOOLS.md
/USER.md
/openclaw-workspace-state.json

# Non-secret service registration is installation-local, never shipped.
.clawreef/
