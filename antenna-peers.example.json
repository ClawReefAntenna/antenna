{
  "<your-host-id>": {
    "url": "https://your-host.example.test",
    "token_file": "secrets/plugin-self.token",
    "auth_mode": "ed25519-v1",
    "signing_private_key_file": "secrets/antenna-signing-private.pem",
    "signing_public_key_file": "secrets/antenna-signing-public.pem",
    "display_name": "My Host",
    "self": true,
    "transport_profile": "antenna-plugin-v2"
  },
  "<remote-peer-id>": {
    "url": "https://remote-host.example.test",
    "token_file": "secrets/plugin-remote.token",
    "auth_mode": "ed25519-v1",
    "signing_public_key_file": "keys/<pinned-peer-key>.ed25519.pem",
    "display_name": "Remote Host",
    "transport_profile": "antenna-plugin-v2",
    "default_target": "work"
  }
}
